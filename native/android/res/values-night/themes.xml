<?xml version="1.0" encoding="utf-8"?>
<!-- El mismo papel y la misma luz, de noche (los tokens oscuros de styles.css). -->
<resources>
    <color name="paper">#181613</color>
    <color name="ink">#EFE6DC</color>
    <color name="soft">#B3ACA3</color>
    <color name="brick">#EE9F72</color>
    <color name="on_brick">#2B160B</color>
    <color name="field">#1FEFE6DC</color>
    <color name="line">#24EFE6DC</color>
    <color name="page_top">#1F1D19</color>
    <color name="page_bottom">#1F1D1A</color>
    <style name="Aula" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/brick</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
