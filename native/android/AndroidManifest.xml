<?xml version="1.0" encoding="utf-8"?>
<!-- Aula para Android: la ventana a la Aula del estudiante (en su Mac o en su servidor) por su red privada de Tailscale.
     native/android/README.md. La versión la pone build.sh (versionCode, versionName) desde package.json. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.luumlabs.aula">

    <!-- solo la red: ni cámara, ni micrófono, ni ubicación, ni contactos (una foto de los apuntes la hace la app de cámara
         que el estudiante elija, y la deja en PhotoProvider) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- para ofrecer la cámara al añadir materiales hay que poder ver si hay una app de cámara (Android 11 o posterior) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- extractNativeLibs: el componente de Tailscale (lib/<abi>/libaulatsnet.so) se instala como archivo ejecutable;
         cleartext solo hacia 127.0.0.1 (el túnel local, xml/network_security_config.xml): fuera, la red privada ya cifra.
         Nada de la app sale del teléfono, ni a la nube ni a otro teléfono: allowBackup="false" lo impide hasta Android 11;
         desde Android 12 ya no impide el paso a otro teléfono, y eso lo hace dataExtractionRules. La identidad de
         Tailscale y la cookie que enlaza este dispositivo con la Aula son de este teléfono.
         enableOnBackInvokedCallback: «atrás» por el despachador del sistema desde Android 13 (MainActivity.updateBack).
         configChanges: girar, cambiar el tema del sistema, el tamaño del texto o el idioma no recrean la actividad (la
         interfaz no se recarga ni pierde lo que se estaba escribiendo); MainActivity.onConfigurationChanged rehace lo suyo -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Aula"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- la foto que hace la app de cámara: solo ella puede escribirla, y solo esa (el permiso va con cada Intent) -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="com.luumlabs.aula.photos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
